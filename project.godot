; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rogue Reproductive"
run/main_scene="res://src/scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/icon.png"

[autoload]

RNG="res://src/autoloads/rng.gd"
GlobalEvents="res://src/autoloads/global_events.gd"
PlayerStats="res://src/autoloads/player_stats.gd"
ItemDatabase="res://src/autoloads/item_database.gd"
LoreDatabase="res://src/autoloads/lore_database.gd"
RunManager="res://src/autoloads/run_manager.gd"
GameController="res://src/autoloads/game_controller.gd"
Narrator="*res://src/autoloads/narrator.gd"
DebugMenu="*res://src/autoloads/debug_menu.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/mode/window_mode=0
rendering/quality/2d/default_canvas_item_texture_filter=0

