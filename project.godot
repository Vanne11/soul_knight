; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rogue Reproductive"
run/main_scene="res://src/scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/icon.png"
config/windows_native_icon="res://assets/icon.ico"

[autoload]

RNG="res://src/autoloads/rng.gd"
GlobalEvents="res://src/autoloads/global_events.gd"
PlayerStats="res://src/autoloads/player_stats.gd"
ItemDatabase="res://src/autoloads/item_database.gd"
LoreDatabase="res://src/autoloads/lore_database.gd"
RunManager="res://src/autoloads/run_manager.gd"
GameController="res://src/autoloads/game_controller.gd"
Narrator="*res://src/autoloads/narrator.gd"
DebugMenu="*res://src/autoloads/debug_menu.gd"
Settings="*res://src/autoloads/settings.gd"
Sound="*res://src/autoloads/sound.gd"
Cursor="*res://src/autoloads/cursor.gd"
TouchControls="*res://src/autoloads/touch_controls.gd"
Transition="*res://src/autoloads/transition.gd"
FourthWall="*res://src/fx/fourth_wall.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/mode/window_mode=0
window/handheld/orientation=4

