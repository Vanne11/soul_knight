[resource]
script = ExtResource("1")
id = "pest_chicle"
title = "Chicle Pegado"
text = "Se te pega a la suela y te frena hasta que lo raspas: un buen dash lo despega. Lleva ahí desde 1998 y no piensa irse por las buenas."
category = 3
