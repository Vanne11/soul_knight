[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "def_tampon_ancla_lore"
title = "Cambiar a Tiempo"
text = "«Anclado de verdad. Pero cámbialo a tiempo.» Dato: el tampón se cambia cada pocas horas, siguiendo las instrucciones del envase, y no se deja más tiempo del indicado. Dejarlo demasiado tiempo se asocia a una infección rara pero grave (el síndrome de shock tóxico). Si durante la regla aparece fiebre alta, mareo o un sarpullido, se retira y se consulta de inmediato."
category = 2
unlock_condition = {"type": 4, "target_id": "def_tampon_ancla", "count": 1}
flavor_text = "Usa un tampón ancla."
