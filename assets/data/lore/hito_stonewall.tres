[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "hito_stonewall"
title = "Stonewall (1969)"
text = "En la madrugada del 28 de junio de 1969, la policía entró a un bar de Nueva York, el Stonewall Inn, como tantas otras veces. Esa vez la clientela no se dejó: hubo varios días de protestas. No fue el primer acto de resistencia, pero se volvió el símbolo del movimiento moderno por los derechos LGBTIQ+."
category = 7
unlock_condition = {"target_id": "reino_orgullo_entrada", "type": 10}
flavor_text = "Fueron por una redada y se llevaron una revolución."
