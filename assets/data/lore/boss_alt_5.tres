[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "boss_alt_5"
title = "Algoritmo Moderador"
text = "Un ojo sin parpadeo que revisa todo y entiende poco. Señala, reporta, pixela, bloquea y manda notificaciones en círculo. Su criterio es una lista de palabras prohibidas y un error de lectura. Dato real: los filtros automáticos de las plataformas confunden a menudo la educación sexual, la lactancia o el cáncer de mama con contenido adulto, y retiran justo lo que más falta hace. Por eso sigue haciendo falta criterio humano y una vía de apelación que no sea gritarle a un formulario. Su apelación, por cierto, está aceptada. Por fin."
category = 3
unlock_condition = {"type": 9, "target_id": "EL ALGORITMO MODERADOR"}
flavor_text = "Derrota al Algoritmo Moderador."
