[resource]
script = ExtResource("1")
id = "boss_alt_5"
title = "El Algoritmo Moderador"
text = "Un ojo sin párpado que revisa todo y entiende poco: es la Hoja en versión nube, porque se llenó de trabajo y contrató automatización. Señala, reporta, pixela y manda notificaciones en círculo. Dato: los filtros automáticos suelen confundir educación sexual, lactancia o cáncer de mama con contenido adulto. Hace falta criterio humano."
category = 3
unlock_condition = {"type": 9, "target_id": "EL ALGORITMO MODERADOR"}
flavor_text = "Derrota al Algoritmo Moderador."
