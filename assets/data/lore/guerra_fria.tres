[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "guerra_fria"
title = "La Guerra Fría Hormonal"
text = "Penelandia y Vulvania llevan siglos sin hablarse. Nadie recuerda por qué; los historiadores apuestan por una disputa de fronteras en el Perineo. Cada reino acabó alérgico a la hormona del otro y toda visita se volvió un festival de estornudos. Luego la Hoja los censuró a los dos por igual. Nada une tanto como un enemigo común. Todavía no."
category = 0
unlock_condition = {"type": 2, "floor": 2}
flavor_text = "Llega a Penelandia."
