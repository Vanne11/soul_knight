[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "condom_lore"
title = "El Preservativo que Cambió la Historia"
text = "Lo encontraste en un cofre y te creíste inmortal: los fluidos resbalaban, el fuego no quemaba. Corriste tres regiones sin un rasguño. Entonces un jefe te pegó tan fuerte que se rompió y el daño se duplicó. Dato: bien usado desde el inicio, el condón falla cerca del 2% al año; con uso típico, cerca del 13% (OMS)."
category = 2
unlock_condition = {"type": 1, "target_id": "relic_condom", "count": 1}
flavor_text = "Equipa el Preservativo de Titanio."