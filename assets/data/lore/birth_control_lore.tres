[resource]
script = ExtResource("1")
id = "birth_control_lore"
title = "Seguro, Pero Aburrido"
text = "El Anticonceptivo Maldito hace lo que promete: nada te pasa. Los fluidos rebotan, el fuego no quema, el veneno no envenena. Quedas intocable y aburridísimo. Los enemigos dejan menos botín porque ni lo intentan. Terminas la run sin una cicatriz que contar. La seguridad total es la muerte de la anécdota."
category = 2
unlock_condition = {"type": 1, "target_id": "relic_birth_control", "count": 1}
flavor_text = "Equipa el Anticonceptivo Maldito."