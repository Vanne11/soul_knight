[resource]
script = ExtResource("1")
id = "bandera_lesbica"
title = "Bandera Lésbica"
text = "Hay más de una. Una de 1999 (Sean Campbell) lleva un labrys sobre violeta; la de los labios (2010, Natalie McCray) fue criticada por dejar fuera a las lesbianas butch. La naranja y rosa, de 2018, se le atribuye a la bloguera Emily Gwen y tiene 7 franjas: naranja oscuro, no conformidad de género; naranja, independencia; naranja claro, comunidad; blanco, relaciones únicas con la feminidad; rosa, serenidad; rosa polvo, amor y sexo; rosa oscuro, feminidad. También circula una de 5 franjas."
category = 7
sprite = ExtResource("2")
unlock_condition = {"target_id": "bandera_hallada_lesbica", "type": 10}
flavor_text = "Cuando una bandera no alcanza, la comunidad hace otra."
