[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "loc_selva"
title = "La Selva Púbica"
text = "Una jungla densa, húmeda y rizada donde nadie pasa la cuchilla desde la Gran Censura. Antes era un lugar tranquilo, con su ecosistema y sus cosas. Ahora la ocupan pelos encarnados con rencor y granitos que escupen. Quien manda aquí quiere dejarlo todo como azulejo. La selva no opina: sigue creciendo. Tú estás en medio, como siempre."
category = 4
unlock_condition = {"type": 2, "region": "selva"}
flavor_text = "Entra en la Selva Púbica."
