[resource]
script = ExtResource("1")
id = "def_autotest_lore"
title = "Mirar Es Cuidar"
text = "«Hacerse el test no es sospechar: es cuidarse.» Dato: hacerse el test de VIH es un acto de cuidado. Hay autotests y centros de salud que lo ofrecen. Un resultado reactivo se confirma con un profesional de salud, que además te acompaña con lo que sigue."
category = 2
unlock_condition = {"type": 4, "target_id": "def_autotest", "count": 1}
flavor_text = "Hazte un autotest."
