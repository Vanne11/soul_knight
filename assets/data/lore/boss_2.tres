[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "boss_2"
title = "El Testículo Primordial"
text = "Patriarca de Penelandia: un testículo del tamaño de un coche, con un ojo al centro y una decepción de siglos. Ataca con expectativas incumplidas y refuerzos de espermatozoides. Dato: una vez al mes, tras la ducha, toca y mira si hay bultos o cambios. Si encuentras algo, al médico sin miedo: detectado a tiempo, casi siempre se cura."
category = 3
unlock_condition = {"type": 9, "target_id": "TESTÍCULO PRIMORDIAL"}
flavor_text = "Derrota al patriarca de Penelandia."
