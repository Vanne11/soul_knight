[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "mito_el_armario"
title = "«El Armario»"
text = "Verdad: nadie le debe su orientación ni su identidad a los demás. Salir del clóset es voluntario y cada quien decide su ritmo; el secreto no es vergüenza, es privacidad. El problema nunca es el armario sino que haya que esconderse. Un armario sirve para guardar abrigos, no personas."
category = 7
unlock_condition = {"target_id": "orgullo_vencido_el_armario", "type": 10}
flavor_text = "Un armario sirve para abrigos, no para personas."
