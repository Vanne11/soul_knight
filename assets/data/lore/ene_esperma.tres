[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_esperma"
title = "Espermatozoide"
text = "Nunca viene solo: llega en grupos de tres, nada en círculos meneando la cola y, cuando le toca, se para, brilla y sale disparado. Tiene una meta en la vida y no sabe bien cuál, así que eres tú. Millones de primos compiten cada día por llegar primero a algún sitio. Estos decidieron que ese sitio es tu cara."
category = 3
unlock_condition = {"type": 0, "target_id": "Espermatozoide", "count": 20}
flavor_text = "Mata 20 espermatozoides."
