[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "grenade_lore"
title = "No Te Quedes a Ver los Fuegos Artificiales"
text = "La Granada de Fragmentación es simple: la lanzas, cuentas uno, dos, BOOM. 80 de daño en 120 de radio. Muere todo: enemigos, items, secretos, a veces tú. La mecha dura 2 segundos y la vida de una granada es más intensa que la tuya: nace, vuela, estalla y muere con propósito. Lánzala, corre y no mires atrás."
category = 2
unlock_condition = {"type": 4, "target_id": "grenade_frag", "count": 10}
flavor_text = "Usa 10 granadas de fragmentación."