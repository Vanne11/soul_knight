[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_gran_urologo"
title = "El Gran Urólogo"
text = "Una mano entera, con todos sus dedos, y todos con ganas de colaborar. Como el Dedo, solo te hace daño por la espalda; la diferencia es que cuando se pone nervioso suelta Dedos que te rodean entre todos. Es un minijefe con un mensaje: si tienes más de 50 años (o más de 45 con antecedentes familiares), hablar de la próstata con tu médico no es de valientes ni de cobardes, es de gente que quiere ver crecer a sus nietos. La consulta es corta. El guante, desechable."
category = 3
unlock_condition = {"type": 0, "target_id": "El Gran Urólogo", "count": 1}
flavor_text = "Vence al Gran Urólogo."
