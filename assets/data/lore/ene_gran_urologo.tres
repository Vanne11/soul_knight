[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_gran_urologo"
title = "El Gran Urólogo"
text = "Una mano entera, con todos sus dedos y todos con ganas de colaborar. Como el Dedo, solo daña por la espalda; cuando se pone nervioso suelta Dedos que te rodean. Minijefe con mensaje: desde los 50 años (45 con antecedentes), la próstata se conversa con el médico. La consulta es corta. El guante, desechable."
category = 3
unlock_condition = {"type": 0, "target_id": "El Gran Urólogo", "count": 1}
flavor_text = "Vence al Gran Urólogo."
