[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "loc_utero"
title = "El Útero"
text = "El reino del ciclo menstrual, justo antes de la Próstata: la Matrona V. te recibe en la entrada, sin turno. Cuatro tramos, cuatro fases del ciclo: menstruación (marea roja y calambres), folicular (todo florece), ovulación (todos acelerados; hay que alcanzar el óvulo) y lútea (irritables y con antojos; el chocolate cura el doble). Un ciclo dura cerca de un mes."
category = 4
unlock_condition = {"type": 10, "target_id": "enter_utero"}
flavor_text = "La Matrona V. atiende sin turno."
