[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "lube_lore"
title = "Suavidad a Nivel Subatómico"
text = "El Lubricante Cuántico elimina la fricción: conceptual, física y metafóricamente. Dasheas sin costo y nada te frena: ni el suelo, ni las paredes, ni tus propios errores. Suena perfecto, hasta que descubres que sin fricción no puedes parar, ni girar, ni aferrarte a nada. Solo deslizas, siempre hacia adelante: el siguiente jefe, la siguiente muerte."
category = 2
unlock_condition = {"type": 1, "target_id": "relic_lube", "count": 1}
flavor_text = "Equipa el Lubricante Cuántico."