[resource]
script = ExtResource("1")
id = "ene_shibari"
title = "Shibari"
text = "Un maestro de las cuerdas que te corta la huida con redes: tramos de cuerda justo donde ibas a correr. Tus disparos las rompen. El shibari es un arte japonés de atar con cuerda; quien lo practica en serio estudia nudos que no cortan la circulación y tiene tijeras de emergencia a mano. Este solo sabe la parte de las cuerdas."
category = 3
unlock_condition = {"type": 0, "target_id": "Shibari", "count": 6}
flavor_text = "Vence a 6 Shibaris."
