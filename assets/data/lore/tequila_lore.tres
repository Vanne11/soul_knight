[resource]
script = ExtResource("1")
id = "tequila_lore"
title = "Un Caballito No Hace Daño (Mientes)"
text = "Quema la garganta. +30 intoxicación, -20% precisión, +25% daño, +10% velocidad. «Un caballito no hace daño», te dices, y te tomas el segundo, el tercero, el cuarto. La sal, el limón, el ritual. Corres más, fallas más, pegas más fuerte: el equilibrio perfecto entre «puedo con esto» y «me voy a matar». El gusano del fondo no te juzga. Solo espera."
category = 2
unlock_condition = {"type": 4, "target_id": "tequila", "count": 8}
flavor_text = "Bebe 8 tequilas."