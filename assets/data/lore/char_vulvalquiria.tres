[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "char_vulvalquiria"
title = "Vulvalquiria, Guerrera del Norte"
text = "Viene de los fiordos de Vulvania, donde el invierno dura nueve meses y la paciencia, cinco minutos. Cero batallas perdidas, sin contar las que abandonó por aburridas. Hace doble dash, planea con las alas y grita. En Penelandia, alérgica a la testosterona, estornuda y quiere discutir de fútbol. La Hoja le tapó la sala de trofeos."
category = 1
unlock_condition = {"type": 10, "target_id": "play_vulvalquiria"}
flavor_text = "Juega una run con Vulvalquiria."
