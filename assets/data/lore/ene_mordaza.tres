[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_mordaza"
title = "La Mordaza"
text = "Lanza bolas con correa que te silencian: sin habilidades de héroe unos segundos, y hasta el narrador se calla. Es el enemigo más fiel a la idea del Palacio: tapar la boca de quien tiene algo que decir. Apunte serio: cuando una mordaza se usa por gusto entre adultos, va con una señal de seguridad que no dependa de hablar, como soltar un objeto."
category = 3
unlock_condition = {"type": 0, "target_id": "La Mordaza", "count": 6}
flavor_text = "Vence a 6 Mordazas (el silencio también se rompe a tiros)."
