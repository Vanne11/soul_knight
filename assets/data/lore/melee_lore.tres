[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "melee_lore"
title = "Duro, Frío, Sin Sentimientos. Como Tu Ex."
text = "El Consolador de Acero no es un arma. Es una declaración de intenciones. 35 de daño cuerpo a cuerpo. 60 de alcance. Golpeas y duele. Cada tres golpes, crítico garantizado. CRUNCH. El sonido de hueso rompiéndose. O plástico. Da igual. Te obliga a acercarte. A olerlos. A sentir su calor. A mirarlos a los ojos (o al ojo central) antes de reventarlos. Es íntimo. Violento. Personal. No hay pantalla entre tú y la muerte. Solo acero frío y tu fuerza. Y cuando acaba... te queda la mano vacía. Fría. Sola. Como siempre."
category = 2
unlock_condition = {"type": 1, "target_id": "melee_dildo", "count": 1}
flavor_text = "Equipa el Consolador de Acero."