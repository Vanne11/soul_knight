[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "elites"
title = "Élites con Afijos"
text = "A veces un bicho común se mira al espejo, se cree especial y le sale un ego del tamaño de un anillo rojo. Cada élite trae uno o dos afijos, como las propinas: nadie los pidió y siempre cuestan. Veloz, Blindado, Vampiro, Explosivo, Invocador, Saltarín, Espejado, Venenoso, Vengativo, Pegajoso. Mira los iconos. Si ves Explosivo y Vampiro, corre."
category = 3
unlock_condition = {"type": 10, "target_id": "elite", "count": 3}
flavor_text = "Mata a 3 élites con afijos."
