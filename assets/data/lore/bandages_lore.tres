[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "bandages_lore"
title = "Mejor No Preguntar Por Qué Huelen Así"
text = "Vendas Sucias. 30 vida. Probablemente usadas. 'Mejor no preguntar por qué huelen así.' Las usas. La vida sube. El olor se te queda en los dedos. En la nariz. En la mente. ¿De quién eran? ¿Para qué? ¿En qué herida? Da igual. 30 vida son 30 vida. En este juego, la higiene es un lujo. La dignidad, otro. Te vendas con trapos que vieron más sangre que un cirujano de guerra. Y curan. Porque la carne no pregunta. Solo cierra. Y tú sigues. Con el olor ajeno en la piel. Y tu propia sangre debajo. Capa tras capa. Venda tras venda. Run tras run."
category = 2
unlock_condition = {"type": 4, "target_id": "bandages", "count": 20}
flavor_text = "Usa 20 vendas sucias."