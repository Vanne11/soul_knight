[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "bandages_lore"
title = "Mejor No Preguntar Por Qué Huelen Así"
text = "Vendas Sucias: +30 de vida. Probablemente usadas. El cartel dice «mejor no preguntar por qué huelen así», y por una vez el cartel tiene razón. ¿De quién eran? ¿En qué herida? Da igual: la carne no pregunta, solo cierra. Higiene y dignidad son lujos; treinta de vida son treinta de vida."
category = 2
unlock_condition = {"type": 4, "target_id": "bandages", "count": 20}
flavor_text = "Usa 20 vendas sucias."