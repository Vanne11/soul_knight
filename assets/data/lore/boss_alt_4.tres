[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "boss_alt_4"
title = "La Ventanilla Única"
text = "Una ventanilla con piernas y ningún interés en atenderte. Reparte fichas, cierra cubículos por almuerzo, llena la sala de gente en cola y te lanza papeles en espiral. Siempre falta un papel. Hace poco se llamaba otra cosa, pero la próstata se mudó a la región de al lado, con sus datos y todo, y ella se quedó con el escritorio."
category = 3
unlock_condition = {"type": 9, "target_id": "LA PRÓSTATA BUROCRÁTICA"}
flavor_text = "Derrota a la Ventanilla Única."
