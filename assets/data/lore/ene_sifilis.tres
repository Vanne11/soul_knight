[resource]
script = ExtResource("1")
id = "ene_sifilis"
title = "Sífilis Imitadora"
text = "La llaman «la gran imitadora» porque sus síntomas se parecen a los de muchas otras cosas, y se toma el apodo muy en serio: se disfraza de otro bicho, con lentes y bigote falso. Se quita el disfraz justo antes de embestir. Dato: se cura con penicilina si se detecta a tiempo, y un análisis de sangre la descubre aunque se haga la desentendida."
category = 3
unlock_condition = {"type": 0, "target_id": "Sífilis Imitadora", "count": 10}
flavor_text = "Mata 10 sífilis imitadoras."
