[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "drunk_secret"
title = "La Puerta de la Vergüenza"
text = "Encontraste la llave oxidada y la usaste borracho. La puerta se abrió. Dentro no había tesoro, ni poder, ni conocimiento: solo un espejo con tu reflejo mirándote con decepción. La vergüenza es el único jefe al que no se le puede disparar. Esta puerta solo se abre a partir de la intoxicación de nivel 2, cuando uno por fin acepta la verdad."
category = 5
unlock_condition = {"type": 3, "intoxication_tier": 2}
flavor_text = "Usa la Llave Oxidada estando borracho."