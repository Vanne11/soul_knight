[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "drunk_secret"
title = "La Puerta de la Vergüenza"
text = "Encontraste la llave. La usaste. La puerta se abrió. Dentro no había tesoro, ni poder, ni conocimiento. Solo un espejo. Y tu reflejo te miraba con decepción. 'Otra run más', susurró. 'Otra vez muriendo en el piso 3'. La vergüenza es el único boss que no puedes matar a tiros. Requiere intoxicación tier 2+ para aceptar la verdad."
category = 5
unlock_condition = {"type": 3, "intoxication_tier": 2}
flavor_text = "Desbloqueada al usar la Llave Oxidada estando borracho."