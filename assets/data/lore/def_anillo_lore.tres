[resource]
script = ExtResource("1")
id = "def_anillo_lore"
title = "El Aro Que No Cuenta Cuentos"
text = "«Mantén las distancias, por favor.» Dato: el anillo vaginal es un método hormonal: un aro flexible que libera hormonas y se cambia según la indicación del profesional de salud (el esquema depende del producto). No protege de las ITS, por eso se puede combinar con condón."
category = 2
unlock_condition = {"type": 4, "target_id": "def_anillo", "count": 1}
flavor_text = "Lleva un anillo vaginal."
