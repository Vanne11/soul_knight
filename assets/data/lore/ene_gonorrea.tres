[resource]
script = ExtResource("1")
id = "ene_gonorrea"
title = "Gonorrea Goteante"
text = "Va dejando gotitas por donde pasa, como quien riega una planta que nadie pidió. Pisarlas escuece, no más. Dato: la gonorrea real da ardor al orinar o flujo extraño, o nada, y se cura con antibióticos si se detecta a tiempo. Hay cepas resistentes (OMS), así que el tratamiento lo indica un médico. El condón es baratísimo."
category = 3
unlock_condition = {"type": 0, "target_id": "Gonorrea Goteante", "count": 10}
flavor_text = "Mata 10 gonorreas goteantes."
