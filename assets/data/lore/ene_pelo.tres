[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_pelo"
title = "Pelo Encarnado"
text = "Un pelo que quiso crecer hacia fuera y la vida lo empujó hacia dentro. Desde entonces está rizado, irritado y resentido. Embiste y luego queda agotado: ese es tu momento. Dato: los encarnados se previenen exfoliando y evitando el rasurado al ras; si se infectan, se consulta. No es mala persona: es un pelo con un mal día que dura años."
category = 3
unlock_condition = {"type": 0, "target_id": "Pelo Encarnado", "count": 10}
flavor_text = "Mata 10 pelos encarnados."
