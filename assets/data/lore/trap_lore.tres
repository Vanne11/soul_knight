[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "trap_lore"
title = "Click. Aaaaah. Click."
text = "La Trampa de Oso (Tamaño Humano) no discrimina. Pisa el enemigo: click, 60 de daño, inmovilizado 3 segundos. Pisas tú: exactamente lo mismo. La trampa no sabe de bandos, solo de peso y dolor. La colocas con estrategia: CLICK, satisfacción. Luego olvidas dónde, corres: CLICK, ironía. La trampa siempre gana porque la trampa eres tú."
category = 2
unlock_condition = {"type": 4, "target_id": "trap_bear", "count": 3}
flavor_text = "Activa 3 trampas de oso."