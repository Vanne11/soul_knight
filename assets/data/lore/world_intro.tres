[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "world_intro"
title = "La Gran Censura"
text = "Hubo un tiempo en que el mundo andaba como quería: estatuas sin complejos, libros de biología con dibujos de verdad. Entonces llegó la Hoja de Parra con su collar de perlas y lo tapó todo: estatuas, cuadros, gente. El mundo quedó gris, callado y de mal humor. Cada sala liberada recupera su color. Es una limpieza de primavera, con violencia."
category = 0
unlock_condition = {"type": 2, "floor": 1}
flavor_text = "Empieza tu primera run."
