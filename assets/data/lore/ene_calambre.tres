[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_calambre"
title = "Calambre"
text = "Un rayo en zigzag, pequeño y con un enfado enorme. Viene en grupo, en el peor momento y sin consultar tu calendario. Bueno, sí avisa: brilla antes de lanzarse. Aun así, como todo calambre, se va dejándote dolorido y con ganas de sofá y manta."
category = 3
unlock_condition = {"type": 0, "target_id": "Calambre", "count": 20}
flavor_text = "Mata 20 calambres."
