[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "shotgun_lore"
title = "Para Cuando Necesitas Abrir Piernas... y Cráneos"
text = "La Escopeta Pélvica no apunta: escupe. Seis perdigones con una forma que ya te imaginas, 25 de daño cada uno; a quemarropa, 150. Casi 17 grados de dispersión, obscena. Es un arma de «que Dios te pille confesado»: pasillos, cuartos chicos, jefes a bocajarro. El retroceso te empuja hacia atrás, como la vida. Recargar tarda 1,2 segundos. La eternidad."
category = 2
unlock_condition = {"type": 1, "target_id": "shotgun_pelvic", "count": 1}
flavor_text = "Equipa la Escopeta Pélvica."