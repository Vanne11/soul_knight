[resource]
script = ExtResource("1")
id = "concepto_identidad_genero"
title = "Identidad de Género"
text = "Es lo que cada persona siente que es: mujer, hombre, ambos, ninguno u otra cosa. Puede coincidir con el sexo asignado (cis) o no (trans, no binario). No se elige ni se corrige: se reconoce, y la sabe quien la vive."
category = 7
unlock_condition = {"target_id": "reino_orgullo_entrada", "type": 10}
flavor_text = "Nadie lo sabe mejor que tú."
