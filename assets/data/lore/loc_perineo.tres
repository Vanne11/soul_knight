[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "loc_perineo"
title = "El Perineo"
text = "La franja entre Penelandia y Vulvania. Anatómicamente, es real. Políticamente, es un desastre. Ningún reino la reclama, así que manda la burocracia: ventanillas, colas y formularios por triplicado. Para avanzar hacen falta las dos hormonas, la tuya y la contraria. Sí, vas a estornudar. El progreso da un poco de alergia."
category = 4
unlock_condition = {"type": 2, "floor": 4}
flavor_text = "Llega al Perineo."
