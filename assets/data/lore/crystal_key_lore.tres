[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "crystal_key_lore"
title = "La Perfección Rota"
text = "No recibiste ni un rasguño en toda la región. El cristal brilla en tu mano, frío e imposible. Abres la puerta y no hay jefe: hay un espejo donde tu reflejo sonríe y tú no. Al romperse, el cristal avisa que la perfección es lo único que no se puede repetir. Ahora tienes una grieta. Por ahí entra la luz. O la humedad."
category = 2
unlock_condition = {"type": 1, "target_id": "key_crystal", "count": 1}
flavor_text = "Completa una región sin daño y usa la Llave de Cristal."