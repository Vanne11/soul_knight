[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "player_identity"
title = "El Narrador: Currículum de un Pesado"
text = "Antes de comentar tus fracasos, el narrador era Censor Descriptor Oficial del Ministerio de la Censura: describía en voz alta lo que la Hoja tapaba, para que constara en acta. Lo despidieron por describir demasiado bien; la carta la firma «Vane, Recursos Humanos». Ahora describe jugadores. Prometió hablar poco. No le caes mal. Bueno, un poco."
category = 1
unlock_condition = {"type": 10, "target_id": "death", "count": 3}
flavor_text = "Muere 3 veces."
