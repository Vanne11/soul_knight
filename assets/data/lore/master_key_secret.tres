[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "master_key_secret"
title = "La Puerta Maestra"
text = "La llave dorada gira en la cerradura. La puerta se abre. Dentro no hay tesoro. Hay un trono. Y sentado en él, TÚ. De otra run. De otra vida. Te mira con ojos vacíos y susurra: '¿Otra vez? ¿Cuántas veces más vas a morir antes de entender que el único boss eres tú?' La llave se deshace en polvo. La puerta se cierra. La run continúa."
category = 6
unlock_condition = {"type": 4, "target_id": "key_master", "count": 1}
flavor_text = "Desbloqueada al usar la Llave Maestra en Blackout."