[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "master_key_secret"
title = "La Puerta Maestra"
text = "La llave dorada gira en la cerradura y la puerta se abre. Dentro no hay tesoro: hay un trono, y sentado en él, TÚ, de otra run. Te mira con ojos vacíos y pregunta cuántas veces más vas a morir antes de entender que el único jefe eres tú. La llave se deshace en polvo, la puerta se cierra y la run continúa. Tú, un poco menos."
category = 6
unlock_condition = {"type": 4, "target_id": "key_master", "count": 1}
flavor_text = "Usa la Llave Maestra en Blackout."