[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "perineo_suelo_pelvico"
title = "El Suelo Pélvico"
text = "El perineo no es solo frontera: debajo hay un grupo de músculos, el suelo pélvico, que sostiene la vejiga, el intestino y, según el cuerpo, el útero o la próstata. Lo tienen todos los cuerpos. Ayuda a aguantar el pis, participa en el placer y trabaja fuerte en el embarazo y el parto. Se entrena con los ejercicios de Kegel: aprietas como si cortaras el pis, aguantas unos segundos y sueltas (no se practica orinando de verdad). Si hay escapes de orina o dolor, existe la kinesiología o fisioterapia de suelo pélvico: consultar es normal."
category = 5
unlock_condition = {"type": 2, "region": "perineo"}
flavor_text = "Frontera, sí. Pero con músculo."
