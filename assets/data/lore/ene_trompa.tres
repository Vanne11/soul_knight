[resource]
script = ExtResource("1")
id = "ene_trompa"
title = "Trompa Escupidora"
text = "Una trompa de Falopio con flecos que usa como manos, como cañón y como argumento en las discusiones. Se mantiene lejos, carga y escupe en abanico. Es la encargada de controlar quién entra y quién sale de Vulvania, y se toma su trabajo muy en serio. Si no tienes cita previa, te escupe. Si tienes cita previa, también, pero con más educación."
category = 3
unlock_condition = {"type": 0, "target_id": "Trompa Escupidora", "count": 10}
flavor_text = "Mata 10 trompas."
