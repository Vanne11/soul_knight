[resource]
script = ExtResource("1")
id = "pest_notificacion"
title = "Aviso Insistente"
text = "Lento pero impredecible: reaparece justo detrás de ti con un ding-ding y desaparece cuando lo miras. Se cura solo con el modo «No molestar», que este reino no incluye."
category = 3
unlock_condition = {"type": 10, "target_id": "pest_notificacion"}
flavor_text = "Encuéntralo en un pasillo entre reinos."
