[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "stimulant_lore"
title = "Rendimiento a Crédito: Pagas Después"
text = "El Estimulante de Combate te hace dios por 15 segundos: +40% velocidad, +30% cadencia, +25% daño. Vuelas, destruyes, ríes. Luego viene el crash: 10 segundos al 50% de todo. Te arrastras y los enemigos te rodean, y duele el doble porque recuerdas cómo eras hace 15 segundos. No te da poder: te lo presta. Y el prestamista siempre cobra."
category = 2
unlock_condition = {"type": 4, "target_id": "stimulant_combat", "count": 5}
flavor_text = "Usa 5 estimulantes de combate."