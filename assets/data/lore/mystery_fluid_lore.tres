[resource]
script = ExtResource("1")
id = "mystery_fluid_lore"
title = "Solo Hay Una Forma de Saberlo"
text = "El Fluido Misterioso (?). ¿Orina? ¿Leche materna? ¿Agua bendita? ¿Sudor de jefe? ¿Lágrimas de desarrollador? Ruleta rusa en botella: a veces curas 50, a veces pierdes 30, a veces te emborrachas, a veces aparece un jefe. «Solo hay una forma de saberlo», dice la etiqueta. Mentira: ya lo sabes. Lo bebes igual."
category = 2
unlock_condition = {"type": 4, "target_id": "mystery_fluid", "count": 20}
flavor_text = "Bebe 20 Fluidos Misteriosos."