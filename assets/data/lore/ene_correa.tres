[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_correa"
title = "La Correa"
text = "Te engancha desde lejos y te arrastra hacia su dueño, que espera con una embestida. El dash te suelta. Detrás de la caricatura hay un asunto serio: el juego con correa y collar solo es juego si todas las partes lo acordaron. Quien tira sin permiso pierde el permiso de seguir tirando."
category = 3
unlock_condition = {"type": 0, "target_id": "La Correa", "count": 6}
flavor_text = "Vence a 6 Correas (el dash es tu amigo)."
