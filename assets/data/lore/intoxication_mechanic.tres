[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "intoxication_mechanic"
title = "La Barra de Toxicidad"
text = "Sube con el alcohol y con las hormonas del reino contrario. Achispado: más daño, peor puntería. Borracho: más daño, disparos torcidos. Blackout: daño brutal, puntería de primo en un matrimonio y la sensación de que todo tiene sentido. No lo tiene. Baja sola, y el café ayuda. Sobrio ves el mundo gris. Borracho también, pero te importa menos."
category = 5
unlock_condition = {"type": 3, "intoxication_tier": 3}
flavor_text = "Alcanza el Blackout por primera vez."
