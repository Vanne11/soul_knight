[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "boss_1"
title = "Doña Cera Caliente"
text = "Esteticista de profesión, verdugo por vocación: mira el mundo y ve azulejos. Lanza abanicos de cera hirviendo, embiste con la espátula y promete ingles brillantes para todos. Acaba quemándose con su propia cera, y la selva vuelve a crecer: cada uno con su jardín como quiera. Dato: depilarse es estética, no higiene. El vello no es suciedad."
category = 3
unlock_condition = {"type": 9, "target_id": "DOÑA CERA CALIENTE"}
flavor_text = "Derrota a la jefa de la Selva Púbica."
