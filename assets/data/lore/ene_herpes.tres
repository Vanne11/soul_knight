[resource]
script = ExtResource("1")
id = "ene_herpes"
title = "Herpes Recurrente"
text = "La das por muerta y a los seis segundos vuelve, con cara de «¿me extrañaste?». Si no pisas su ampolla, rebrota con media vida (una sola vez, tiene modales). El herpes real queda latente y reaparece con estrés o cansancio. No se cura del todo, pero se controla muy bien con tratamiento, y el condón baja el riesgo de contagio."
category = 3
unlock_condition = {"type": 0, "target_id": "Herpes Recurrente", "count": 10}
flavor_text = "Mata 10 herpes recurrentes."
