[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "alergia_hormonal"
title = "Alergia Hormonal"
text = "Cada reino es alérgico a la hormona del otro. Si vienes de Penelandia y tomas estrógeno (o al revés con testosterona), sube tu toxicidad y estornudas sin control. Y la necesitas: sin ella, la Puerta Hormonal no abre. Es el cuñado en Navidad: no lo soportas y igual lo sientas a tu mesa. El Ornitorrinco no tiene alergias. Envidia sana."
category = 5
unlock_condition = {"type": 10, "target_id": "allergy"}
flavor_text = "Sufre tu primera alergia hormonal."
