[resource]
script = ExtResource("1")
id = "def_bolsa_agua_lore"
title = "Calorcito"
text = "«Cura todo… lo que el calorcito pueda curar.» Dato: el calor local ayuda a aliviar los cólicos menstruales. Se usa con una funda o un paño, sin dormirse encima y sin que esté demasiado caliente, para evitar quemaduras."
category = 2
unlock_condition = {"type": 4, "target_id": "def_bolsa_agua", "count": 1}
flavor_text = "Usa una bolsa de agua caliente."
