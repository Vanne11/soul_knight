[resource]
script = ExtResource("1")
id = "bandera_asexual"
title = "Bandera Asexual"
text = "Es de 2010 y salió de AVEN, la red de visibilidad y educación asexual; la propuso un miembro llamado «standup». Negro, asexualidad; gris, grisexualidad y demisexualidad; blanco, sexualidad (alosexual); morado, la comunidad. Ser asexual es no sentir atracción sexual o sentirla muy poco; no es abstinencia, ni un trauma, ni algo que «se cure»."
category = 7
sprite = ExtResource("2")
unlock_condition = {"target_id": "bandera_hallada_asexual", "type": 10}
flavor_text = "Que no sientas atracción no te hace un robot."
