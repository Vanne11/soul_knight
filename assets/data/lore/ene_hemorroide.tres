[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_hemorroide"
title = "Hemorroide Fronteriza"
text = "Nadie sabe en qué reino nació, pero lleva años plantada en mitad del paso con su gorra de guardia y su franja de peligro. Es lenta y aguanta una barbaridad; cuando se harta de mirarte, se agacha y embiste con todo el cuerpo. Rodéala y que se canse ella. Dato: sangre al evacuar se consulta; suele ser esto, pero conviene confirmarlo."
category = 3
unlock_condition = {"type": 0, "target_id": "Hemorroide Fronteriza", "count": 10}
flavor_text = "Mata 10 hemorroides fronterizas."
