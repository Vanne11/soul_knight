[resource]
script = ExtResource("1")
id = "ene_mito_himen"
title = "Mito: Himen-Certificador"
text = "El mito: «el himen demuestra la virginidad». Este funcionario con sello se protege con una membrana que se rompe al primer golpe, y queda en evidencia: no prueba nada. La verdad: el himen es un pliegue elástico de tejido en la entrada de la vagina, de formas muy distintas, que cambia con el deporte o sin motivo. Que sangre o no, tampoco dice nada."
category = 3
unlock_condition = {"type": 0, "target_id": "Himen-Certificador", "count": 1}
flavor_text = "Vence al Himen-Certificador y rompe el mito."
