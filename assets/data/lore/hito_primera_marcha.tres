[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "hito_primera_marcha"
title = "La Primera Marcha (1970)"
text = "El 28 de junio de 1970, un año después de Stonewall, Nueva York salió a la calle en la Christopher Street Liberation Day, la primera marcha del orgullo. También hubo manifestaciones en otras ciudades de Estados Unidos. De ahí viene que muchas marchas sigan siendo a fines de junio. Era una protesta, no una fiesta: la fiesta vino después, y está bien."
category = 7
unlock_condition = {"target_id": "reino_orgullo_entrada", "type": 10}
flavor_text = "Primero fue marcha; el brillo vino después."
