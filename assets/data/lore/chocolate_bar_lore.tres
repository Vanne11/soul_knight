[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "chocolate_bar_lore"
title = "Antojo Hormonal"
text = "Barra de Chocolate: +15 de vida, baja la toxicidad y calma la alergia. Nadie sabe quién las fabrica ni por qué aparecen justo cuando las necesitas. Los economistas lo llaman oferta y demanda; los endocrinólogos, martes. Tras el primer bocado el mundo se ve un poco menos gris. Dura lo que dura un chocolate: poco."
category = 2
unlock_condition = {"type": 4, "target_id": "chocolate_bar", "count": 8}
flavor_text = "Come 8 barras de chocolate."
