[resource]
script = ExtResource("1")
id = "def_condon_interno_lore"
title = "Por Dentro También Se Puede"
text = "«¿Y si el escudo te queda chico? Ponte la funda completa.» Dato: además del condón externo existe el condón interno, que se coloca dentro de la vagina. Protege del embarazo y de las ITS cuando se usa bien, y es de un solo uso: uno nuevo cada vez. Los condones externo e interno no se usan juntos."
category = 2
unlock_condition = {"type": 4, "target_id": "def_condon_interno", "count": 1}
flavor_text = "Usa un condón interno."
