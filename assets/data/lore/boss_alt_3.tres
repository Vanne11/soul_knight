[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "boss_alt_3"
title = "El DIU Cósmico"
text = "Flota en Vulvania sin pedir nada, una T de cobre. Si lo mueves, se ofende: cruza barras de cobre, tensa hilos de nylon, lanza meteoros y, ya enfadado, hace supernova. Dato: el DIU de cobre previene el embarazo más del 99% de las veces, dura entre 5 y 12 años según el modelo y es reversible. No protege de las ITS: para eso, condón."
category = 3
unlock_condition = {"type": 9, "target_id": "EL DIU CÓSMICO"}
flavor_text = "Derrota al DIU Cósmico."
