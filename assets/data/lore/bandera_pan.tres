[resource]
script = ExtResource("1")
id = "bandera_pan"
title = "Bandera Pan"
text = "Apareció en 2010 en internet, publicada en un Tumblr anónimo por Jasper V. Magenta, amarillo y cian. Según algunas fuentes, el magenta y el cian son atracción hacia mujeres y hacia hombres, y el amarillo hacia personas no binarias. Pansexual: la atracción no depende del género de la persona. No, no tiene que ver con las sartenes."
category = 7
sprite = ExtResource("2")
unlock_condition = {"target_id": "bandera_hallada_pan", "type": 10}
flavor_text = "Pan, de «todo». Nadie dijo sartén."
