[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "concepto_expresion_genero"
title = "Expresión de Género"
text = "Es cómo te muestras: ropa, pelo, voz, gestos, nombre. Se llama femenina, masculina o como quieras. No dice tu identidad ni tu orientación: un hombre con falda sigue siendo lo que él diga, y una mujer con corbata, también."
category = 7
unlock_condition = {"target_id": "reino_orgullo_entrada", "type": 10}
flavor_text = "Una corbata no tiene orientación sexual."
