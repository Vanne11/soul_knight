[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "bloody_key_lore"
title = "La Llave que Sangra"
text = "La llave late en tu mano, tibia y húmeda: cada enemigo que mataste dejó un poquito de sí en ella. Veinte almas para abrir una puerta. La sala del desafío guarda poder, o muerte, o ambas. La llave susurra «sigue matando, necesito más». La usas y se deshace en sangre. Nadie preguntó si querías una llave que hablara."
category = 2
unlock_condition = {"type": 1, "target_id": "key_bloody", "count": 1}
flavor_text = "Obtén la Llave Empapada en Sangre."