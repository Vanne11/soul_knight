[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "sinergias_lore"
title = "Sinergias: Cuando Todo Encaja"
text = "A veces un arma y una bendición se miran, se entienden y rinden más juntas. La Escopeta Pélvica con Calibre Grueso se pone ancha de hombros, la Chancleta Voladora con Orgullo Herido se acuerda de mamá y el Bumerán de Silicona vuelve con ganas de más. El juego avisa una sola vez, con nombre y apellido. Si se rompe la combinación, el efecto se apaga."
category = 5
unlock_condition = {"type": 10, "target_id": "sinergia", "count": 1}
flavor_text = "Activa tu primera sinergia."
