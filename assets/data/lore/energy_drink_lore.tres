[resource]
script = ExtResource("1")
id = "energy_drink_lore"
title = "Te Da Alas... y Taquicardia"
text = "Monster Energy (Marcablanca): alas de cartón. +40 estamina, +15% velocidad 10 s, +10 intoxicación (el azúcar es droga). El corazón te late en la garganta y ves el código del juego. Vas tan rápido que chocas con las paredes. Las alas son de cartón: se mojan, se rompen y caes. La lata dice que te da alas. No dice que el suelo es duro."
category = 2
unlock_condition = {"type": 4, "target_id": "energy_drink", "count": 10}
flavor_text = "Bebe 10 Monster Energy."