[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "char_ornitorrinco"
title = "El Ornitorrinco, No Especifica"
text = "Pico de pato, cola de castor, pone huevos, es mamífero y tiene espolón venenoso. Los primeros naturalistas creyeron que era una broma armada con piezas de otros animales. No pertenece a ningún reino, así que ninguna hormona le hace nada. Habla poco y se pregunta si es un personaje o un error del código. Su sonido: «Ñic.» La Hoja no supo qué tapar."
category = 1
unlock_condition = {"type": 10, "target_id": "play_ornitorrinco"}
flavor_text = "Juega una run con el Ornitorrinco."
