[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_huincha"
title = "Huincha de Medir"
text = "Una cinta métrica con complejo de inspectora: mide puertas, pasillos y héroes. Con Pitocles te persigue para medirte; con Vulvalquiria te pica con el gancho como un estoque; con el Ornitorrinco se queda a cuadros, porque no hay norma para un pico de pato con cola de castor. Lo único que no sabe medir es lo que importa."
category = 3
unlock_condition = {"type": 0, "target_id": "Huincha de Medir", "count": 8}
flavor_text = "Vence 8 huinchas con cada héroe que puedas."
