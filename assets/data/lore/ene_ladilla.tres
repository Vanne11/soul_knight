[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_ladilla"
title = "Ladilla"
text = "Pequeña, rápida y organizada. Ataca en grupo, te rodea y se lanza en línea recta tras un brillo de aviso: si te apartas, falla; si no, pica. No es maldad, es su trabajo y está orgullosa. Dato: las ladillas pasan por contacto cercano (y a veces por ropa o toallas) y se tratan con lociones antiparasitarias."
category = 3
unlock_condition = {"type": 0, "target_id": "Ladilla", "count": 15}
flavor_text = "Mata 15 ladillas."
