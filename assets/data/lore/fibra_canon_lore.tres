[resource]
script = ExtResource("1")
id = "fibra_canon_lore"
title = "Regularidad"
text = "Avena, legumbres, frutas y mucha agua. Dato: frutas, verduras, legumbres, cereales integrales y agua: la fibra necesita agua para ablandar la caca. Moverte también ayuda."
category = 2
unlock_condition = {"type": 4, "target_id": "fibra_canon", "count": 1}
flavor_text = "Usa un fibra cañón."
