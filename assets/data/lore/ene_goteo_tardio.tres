[resource]
script = ExtResource("1")
id = "ene_goteo_tardio"
title = "Goteo Tardío"
text = "Dispara de a poco y tarda un mundo en empezar: se queda quieto, se concentra y suelta un hilito de proyectiles que ya no llega como antes. Dato: chorro débil, goteo al final, ganas urgentes o dificultad para empezar son síntomas urinarios comunes con los años. Se consultan: tienen tratamiento."
category = 3
unlock_condition = {"type": 0, "target_id": "Goteo Tardío", "count": 10}
flavor_text = "Mata 10 Goteos Tardíos."
