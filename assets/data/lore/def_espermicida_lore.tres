[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "def_espermicida_lore"
title = "Mejor en Compañía"
text = "«Un gel valiente, pero no hace milagros.» Dato: los espermicidas usados solos son poco eficaces para evitar el embarazo y no protegen de las ITS. Funcionan mejor combinados con condón."
category = 2
unlock_condition = {"type": 4, "target_id": "def_espermicida", "count": 1}
flavor_text = "Usa espermicida."
