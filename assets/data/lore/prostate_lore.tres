[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "prostate_lore"
title = "La Iluminación Prohibida"
text = "Lo encontraste, lo equipaste y el universo se abrió: cada crítico es una revelación, cada explosión en cadena un mantra. Aquí la próstata ascendió de glándula a chakra, y cuando criticas el cosmos lanza estrellas. Luego viene el enfriamiento, el vacío posterior. Vale la pena, hasta que notas que la iluminación no paga el arriendo."
category = 2
unlock_condition = {"type": 1, "target_id": "relic_prostate", "count": 1}
flavor_text = "Equipa la Próstata Iluminada."