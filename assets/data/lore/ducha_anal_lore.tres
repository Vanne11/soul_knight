script = ExtResource("1")
id = "ducha_anal_lore"
title = "Presión Moderada"
text = "«Con una ducha basta. Con dos, ya es costumbre.» Dato: no hace falta ningún ritual extremo. Con higiene normal basta; las duchas internas o enemas frecuentes pueden irritar. — Cartel de la farmacia 24 h."
