[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "loc_vulvania"
title = "Vulvania"
text = "Elegante, ordenada y regida por un calendario que nadie de fuera entiende. Los jardines florecen por ciclos y a nadie le sobra paciencia con quien pregunta lo evidente. Desde la Gran Censura, los óvulos ruedan sin rumbo y las trompas escupen a quien no pidió cita. Se entra con estrógeno. Si vienes de Penelandia: estornudos y sentimientos, a la vez."
category = 4
unlock_condition = {"type": 2, "region": "vulvania"}
flavor_text = "Llega a Vulvania."
