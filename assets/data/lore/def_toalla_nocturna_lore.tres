[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "def_toalla_nocturna_lore"
title = "Cobertura Nocturna"
text = "«Larga, ancha y sin miedo al turno de noche.» Dato: las toallas higiénicas se cambian con regularidad y las nocturnas, más largas, dan cobertura para dormir. La cantidad de flujo menstrual varía mucho entre personas y es normal que así sea; empapar una toalla cada hora durante varias horas seguidas es motivo para consultar con un profesional de salud."
category = 2
unlock_condition = {"type": 4, "target_id": "def_toalla_nocturna", "count": 1}
flavor_text = "Usa una toalla nocturna absorbente."
