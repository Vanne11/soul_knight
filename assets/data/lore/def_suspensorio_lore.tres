[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "def_suspensorio_lore"
title = "Equipo de Contacto"
text = "«Cuerpo a cuerpo, de frente: por aquí no pasa nadie.» Dato: el suspensorio con protector rígido es un equipo de protección para deportes de contacto o de mucho impacto, como el boxeo, el hockey o el fútbol americano. Se elige de la talla correcta y se usa en los entrenamientos y partidos, no solo el día del partido."
category = 2
unlock_condition = {"type": 4, "target_id": "def_suspensorio", "count": 1}
flavor_text = "Usa un suspensorio blindado."
