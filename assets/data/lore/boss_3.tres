[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "boss_3"
title = "Su Majestad Ovaria II"
text = "Reina de Vulvania por gracia del ciclo: capa morada, corona de oro (la única del mundo con papeles) y cara de no tener tiempo. Dispara en espiral con trompas de flecos y convoca calambres reales. Dato: los ovarios producen estrógeno y liberan un óvulo por ciclo, más o menos una vez al mes. Ella lo hace con más ceremonia."
category = 3
unlock_condition = {"type": 9, "target_id": "SU MAJESTAD OVARIA II"}
flavor_text = "Derrota a la reina de Vulvania."
