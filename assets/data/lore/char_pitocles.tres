[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "char_pitocles"
title = "Pitocles, Hoplita de Penelandia"
text = "Pitocles se alistó por el casco: le dijeron que el penacho rojo daba autoridad y sigue esperando que haga efecto. Embiste primero y escucha después, o nunca. Su escudo aguanta lo que sea y su dash aturde. En Vulvania, alérgico al estrógeno, estornuda y le dan ganas de hablar de sus sentimientos. La Censura le tapó el penacho con una barra negra."
category = 1
unlock_condition = {"type": 10, "target_id": "play_pitocles"}
flavor_text = "Juega una run con Pitocles."
