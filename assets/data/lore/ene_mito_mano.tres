[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_mito_mano"
title = "Mito: Mano Peluda"
text = "El mito: «si te tocas, te salen pelos en la mano». Esta mano trepadora se llena de pelos al golpearla, pero no pica más ni cambia nada: pura fachada, como el mito. La verdad: la palma no tiene folículos pilosos y la masturbación no causa ceguera ni acné. Es común y sin riesgo para la salud; solo conviene hacerla con manos limpias y sin culpa."
category = 3
unlock_condition = {"type": 0, "target_id": "Mano Peluda", "count": 1}
flavor_text = "Vence a la Mano Peluda para romper el mito."
