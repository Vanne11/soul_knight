[resource]
script = ExtResource("1")
id = "ene_sonda"
title = "Sonda Uretral"
text = "Fina, rápida y con mala fama en Penelandia: se para, apunta una línea roja y sale disparada como lanza. Si falla, queda clavada y agotada. Dato: la sonda uretral es una herramienta médica que drena la vejiga cuando hace falta, siempre por profesionales, con material estéril y lubricante, y se tolera mejor de lo que cuenta la fama."
category = 3
unlock_condition = {"type": 0, "target_id": "Sonda Uretral", "count": 8}
flavor_text = "Vence a 8 Sondas Uretrales."
