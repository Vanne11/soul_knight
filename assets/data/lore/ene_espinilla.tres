[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_espinilla"
title = "Espinilla Reventona"
text = "Brota en la Selva Púbica sin avisar, quietecita, haciéndose la inocente. Se hincha, se pone colorada, tiembla y, cuando no aguanta más, pop: un anillo de gotitas de algo cremoso que prefieres no identificar. Dispárale a tiempo y se desinfla sin escándalo. Dato: reventarlas con los dedos las infecta y deja marca."
category = 3
unlock_condition = {"type": 0, "target_id": "Espinilla Reventona", "count": 10}
flavor_text = "Revienta 10 espinillas (o deja que ellas lo hagan)."
