[resource]
script = ExtResource("1")
id = "pest_ex"
title = "Ex Nocturno"
text = "Se pega a tu ritmo y no se va: da igual cuánto corras, siempre está a tres pasos escribiendo «...». Solo se le saca llegando al final del pasillo. Y bloqueándolo, pero eso no se puede en pixel art."
category = 3
unlock_condition = {"type": 10, "target_id": "pest_ex"}
flavor_text = "Encuéntralo en un pasillo entre reinos."
