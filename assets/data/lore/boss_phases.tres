[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "boss_phases"
title = "Las Fases del Jefe: La Negociación"
text = "Todos los jefes siguen el mismo guion, aunque ninguno lo admite.\n\nFase 1: te mide, con abanicos y embestidas avisadas. La primera cita.\n\nFase 2, al 66%: espirales y refuerzos. La convivencia: salen los defectos.\n\nFase 3, al 33%: anillos con un solo hueco. La ruptura.\n\nSi chocan con la pared, quedan atontados y reciben doble. Y siempre avisan."
category = 3
unlock_condition = {"type": 9, "count": 3}
flavor_text = "Derrota 3 jefes."
