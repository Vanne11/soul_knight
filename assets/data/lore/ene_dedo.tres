[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_dedo"
title = "Dedo del Urólogo"
text = "Un dedo gigante con guante de látex que solo ataca por la espalda. Caricatura del tacto rectal: dura segundos y permite palpar la próstata. Junto al PSA (análisis de sangre; un PSA alto no es sentencia, a veces es solo una próstata inflamada), detecta a tiempo el cáncer de próstata. Se conversa con el médico desde los 50, o 45 con antecedentes."
category = 3
unlock_condition = {"type": 0, "target_id": "Dedo del Urólogo", "count": 6}
flavor_text = "Vence a 6 Dedos del Urólogo."
