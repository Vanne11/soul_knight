[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "syringe_lore"
title = "CLEAR: Directa al Corazón"
text = "La Jeringa de Adrenalina no es medicina: es trampa. 50 de vida al instante, 100 de estamina, 20 de intoxicación. Te la clavas en el pecho. CLEAR. El mundo se acelera y el dolor desaparece 5 segundos. Después las manos tiemblan y el dolor vuelve multiplicado. Pero en un jefe, 5 segundos de dios valen una eternidad de infierno."
category = 2
unlock_condition = {"type": 4, "target_id": "syringe_adrenaline", "count": 3}
flavor_text = "Usa 3 jeringas de adrenalina."