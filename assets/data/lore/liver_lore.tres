[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "liver_lore"
title = "Tu Hígado Ha Visto Cosas. Cosas Terribles."
text = "El Hígado de Acero no es un órgano: es un veterano de guerra. Ha procesado whiskey, absenta, vodka, hidromiel, tequila, ron, fluidos misteriosos y ese café que sabe a ceniza. Y sigue ahí, reduciendo la intoxicación un 30% por pura terquedad. Odia su trabajo, pero lo hace. Como tú. De vez en cuando te manda la factura: la pagas en la siguiente run."
category = 2
unlock_condition = {"type": 1, "target_id": "relic_liver", "count": 1}
flavor_text = "Equipa el Hígado de Acero."