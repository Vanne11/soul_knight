[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "absinthe_lore"
title = "La Hada Verde Te Susurra Verdades"
text = "Prohibida en 12 países y 3 dimensiones. +40% daño, -30% precisión, +50 intoxicación. Los colores sangran, las paredes respiran y una hada verde en tu hombro susurra «tú eres el elegido». Miente: la absenta no revela verdades, inventa mentiras bonitas. Y tú las compras, porque la realidad está gris."
category = 2
unlock_condition = {"type": 4, "target_id": "absinthe", "count": 3}
flavor_text = "Bebe 3 absintas."