[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "loc_penelandia"
title = "Penelandia"
text = "Un reino construido sobre una sola idea: el tamaño importa. Todo es alargado, vertical y levemente inflado. Los edificios compiten por ser el más alto, los ciudadanos por todo lo demás, y nadie pide indicaciones. Huele a desodorante de oferta. Desde la Gran Censura, testículos errantes juzgan desde las esquinas. Se entra con testosterona."
category = 4
unlock_condition = {"type": 2, "floor": 2}
flavor_text = "Llega a Penelandia."
