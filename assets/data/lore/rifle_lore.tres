[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "rifle_lore"
title = "Cada Disparo un Potencial Hijo... o una Baja Confirmada"
text = "El Fusil Fecundador no perdona: 18 de daño, 0,15 s entre disparos, casi sin dispersión. Es un láser: lo apuntas y muere, a cualquier distancia. Seis disparos por segundo, seis decisiones por segundo. Te vuelve eficiente, frío y vacío: los enemigos pasan a ser números, y tú, el contador. Contando bajas, runs y el tiempo que no recuperas."
category = 2
unlock_condition = {"type": 1, "target_id": "rifle_reproductive", "count": 1}
flavor_text = "Equipa el Fusil Fecundador."