[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_granito"
title = "Granito Rencoroso"
text = "Lleva toda la vida esperando el momento perfecto para estallar, y ese momento eres tú. Se hincha, brilla y escupe tres proyectiles de algo mejor no analizar. Mientras se carga queda quieto: si eres rápido, lo revientas antes. Su sueño era aparecer el día de la foto de graduación de alguien. La Censura se lo quitó."
category = 3
unlock_condition = {"type": 0, "target_id": "Granito Rencoroso", "count": 10}
flavor_text = "Mata 10 granitos."
