[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "floor_anatomy"
title = "Mapa de la Gran Censura"
text = "Seis regiones y una secreta.\n\nPitocles despierta en Penelandia, Vulvalquiria en Vulvania y el Ornitorrinco en la Selva Púbica. Cada uno cruza lo que le toca y todos terminan en el Perineo, la Próstata y el Palacio de la Censura.\n\nLa secreta es El Útero: se entra desde Vulvania, con turno."
category = 4
unlock_condition = {"type": 2, "floor": 2}
flavor_text = "Libera tu primera región."
