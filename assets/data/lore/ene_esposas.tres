[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_esposas"
title = "Esposas Peludas"
text = "Te alcanzan, hacen clic y quedas atado con una cadenita: no puedes disparar hasta que las mates, las aturdas o te sueltes machacando botones. Son rosas y de peluche, y aun así, jamás para quien no las pidió. Dato: las esposas reales pueden dañar los nervios de la muñeca; la llave va siempre a mano y, si hormiguea, se suelta."
category = 3
unlock_condition = {"type": 0, "target_id": "Esposas Peludas", "count": 6}
flavor_text = "Vence a 6 Esposas Peludas."
