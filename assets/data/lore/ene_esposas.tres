[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_esposas"
title = "Esposas Peludas"
text = "Te alcanzan, hacen clic y quedas atado a ellas con una cadenita: no puedes disparar hasta que las mates, las aturdas o te sueltes a base de machacar botones. Son rosas, de peluche, de feria; y aun así, nunca vistas a quien no las pidió. Un dato práctico de fuera del juego: las esposas de verdad (peludas o no) pueden dañar los nervios de las muñecas si se aprietan o se dejan mucho rato, y la llave debe estar siempre a mano. Si algo se siente raro, hormigueo o dedos dormidos, se suelta. Siempre."
category = 3
unlock_condition = {"type": 0, "target_id": "Esposas Peludas", "count": 6}
flavor_text = "Vence a 6 Esposas Peludas."
