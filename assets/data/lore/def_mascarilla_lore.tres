[resource]
script = ExtResource("1")
id = "def_mascarilla_lore"
title = "Reducción de Daños"
text = "«Respira tranquilo: ya filtré el drama.» Dato: la reducción de daños busca disminuir los riesgos sin juzgar: informarse, cuidarse y pedir ayuda sin culpa. Evitar respirar vapores, humos y polvo es parte de cuidarse."
category = 2
unlock_condition = {"type": 4, "target_id": "def_mascarilla", "count": 1}
flavor_text = "Ponte la mascarilla."
