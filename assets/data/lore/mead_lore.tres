[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "mead_lore"
title = "La Hidromiel que No Olvida"
text = "Bebes y recuerdas. No tus victorias: tus fracasos. Cada run fallida, cada item vendido por 5 monedas. +40 intoxicación, -10% precisión, +30% daño, +15% velocidad. Odín bebía esto, y también se cayó de su caballo. Tú eres un jugador en ropa interior a las 3 a. m. Por un momento sientes el Valhalla. Luego vomitas. Y sabe mejor de vuelta que de ida."
category = 2
unlock_condition = {"type": 4, "target_id": "mead", "count": 5}
flavor_text = "Bebe 5 hidromieles."