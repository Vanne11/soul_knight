[resource]
script = ExtResource("1")
id = "pest_vendedor"
title = "Vendedor de Planes de Salud"
text = "Corre rápido y se pega a ti con un folleto que frena a cualquiera. Siempre tiene una oferta que vence hoy. Moraleja del reino: lee la letra chica."
