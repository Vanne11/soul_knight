[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "boss_4"
title = "El Aduanero Hormonal"
text = "Gorra de plato, carpeta de formularios y un sello gigante que estampa sobre todo lo que se mueve. Su vida es la frontera: quién pasa, con qué papeles y por qué ventanilla. Pide pasaporte hormonal y el 27-B por triplicado. Clasificar a la gente en casillas siempre deja a alguien afuera. Al caer, el paso queda libre."
category = 3
unlock_condition = {"type": 9, "target_id": "EL ADUANERO HORMONAL"}
flavor_text = "Derrota al guardián del Perineo."
