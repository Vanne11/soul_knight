[resource]
script = ExtResource("1")
id = "rum_lore"
title = "Yo Ho Ho y Una Botella de Arrepentimiento"
text = "Dulce, espeso, pirata. +35 intoxicación, -20% precisión, +25% daño, +5% robo de vida. Robas vida con cada golpe, como un pirata, como un vampiro, como tu ex. El ron no quema: acaricia. Te susurra que el próximo piso será fácil. Te abraza mientras te apuñala. «Yo ho ho», cantas, «y una botella de...» Te callas. La botella está vacía. Tú también."
category = 2
unlock_condition = {"type": 4, "target_id": "rum", "count": 8}
flavor_text = "Bebe 8 rones."