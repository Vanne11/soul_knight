[resource]
script = ExtResource("1")
id = "def_pep_lore"
title = "Consulta de Urgencia"
text = "«Si pasó algo, el reloj corre.» Dato: la PEP es un tratamiento de urgencia tras una posible exposición al VIH: cuanto antes se consulta, mejor, así que ve a una consulta de urgencia. No reemplaza al condón ni es un método habitual."
category = 2
unlock_condition = {"type": 4, "target_id": "def_pep", "count": 1}
flavor_text = "Usa la PEP."
