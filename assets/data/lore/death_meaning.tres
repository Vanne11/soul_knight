[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "death_meaning"
title = "El Significado de la Muerte"
text = "Morir aquí no tiene consecuencias: pierdes la run, las armas y las monedas, y vuelves a elegir héroe. El narrador anota tu muerte en su libreta con letra de funcionario. Cada intento enseña algo: que los avisos avisan, que el dash te salva y que entrar a un jefe a puñetazos es una idea pésima. Diez muertes después, ya lo sabes todo. Falta hacerlo."
category = 5
unlock_condition = {"type": 10, "target_id": "death", "count": 10}
flavor_text = "Muere 10 veces en total."
