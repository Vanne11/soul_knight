[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "flashbang_lore"
title = "¡Luz! ¡Mi Única Debilidad... la Luz!"
text = "El Flashbang Sensorial no mata: ciega. 4 segundos de oscuridad, 80% menos precisión. Los enemigos disparan a ciegas, caen en trampas y se pegan entre sí. Es la única granada pacifista, aunque aquí el pacifismo es otra forma de matar. Sirve para huir y ganar tiempo. Cuatro segundos, a cambio de 40 monedas. Buen trato. Mal negocio."
category = 2
unlock_condition = {"type": 4, "target_id": "grenade_flashbang", "count": 5}
flavor_text = "Usa 5 flashbangs."