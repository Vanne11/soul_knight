[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "medkit_lore"
title = "Para Cuando las Vendas Sucias No Bastan"
text = "El Botiquín Completo: 100 de vida, limpia efectos, restaura escudos. Es el «te lo dije» de tu madre hecho item. Lo guardas «para el jefe final». Llegas al jefe, bajas a 20 de vida y dudas: «¿y si lo necesito después?». No hay después. Lo usas y lo intentaste con todo. El botiquín no te juzga. Solo espera, como tu potencial."
category = 2
unlock_condition = {"type": 4, "target_id": "medkit", "count": 2}
flavor_text = "Usa 2 botiquines."