[resource]
script = ExtResource("1")
id = "pest_mosquito"
title = "Mosquito Moral"
text = "Pequeño, veloz y zumbón: te pica donde más duele, que es la duda. Es casi imposible de aplastar y totalmente inofensivo. Casi."
category = 3
unlock_condition = {"type": 10, "target_id": "pest_mosquito"}
flavor_text = "Encuéntralo en un pasillo entre reinos."
