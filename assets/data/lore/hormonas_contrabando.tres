[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "hormonas_contrabando"
title = "Hormonas de Contrabando"
text = "Desde la Guerra Fría Hormonal, pasar hormonas de un reino a otro es ilegal en los dos. De ahí el mercado negro: viales de testosterona y estrógeno a precio de oro. Abren las Puertas Hormonales y dan alergia si son del reino contrario. La etiqueta dice «no apto para ornitorrincos». Nadie la respeta, menos que nadie el Ornitorrinco."
category = 2
unlock_condition = {"type": 1, "target_id": "hormone_testosterona"}
flavor_text = "Consigue tu primera hormona de contrabando."
