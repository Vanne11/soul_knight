[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_gran_candado"
title = "El Gran Candado"
text = "Guardián de las salas secretas. Cerrado es casi invulnerable: los golpes rebotan con un clank humillante. Solo se abre justo después de embestir, cuando el esfuerzo le deja el arco suelto. Con la mitad de vida suelta dos Jaulas para que se unan a la fiesta. Toda cerradura tiene su llave, y casi siempre se llama paciencia."
category = 3
unlock_condition = {"type": 0, "target_id": "El Gran Candado", "count": 1}
flavor_text = "Vence al Gran Candado."
