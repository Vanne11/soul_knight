[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "loc_palacio"
title = "El Palacio de la Censura"
text = "Enorme, gris y ordenadísimo, y todo pixelado. Los cuadros llevan barras negras, las estatuas albornoz y las columnas una funda de ganchillo. Lo guardan píxeles, barras con patas y sellos que estampan CENSURADO. Huele a moralina y a tila. En el trono, quien manda lleva siglos tapando cosas. Si cae, todo queda al descubierto. Para bien y para mal."
category = 4
unlock_condition = {"type": 2, "floor": 5}
flavor_text = "Llega al Palacio de la Censura."
