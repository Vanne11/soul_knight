[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "steroid_lore"
title = "Roid Rage: La Rabia que Te Hace Fuerte"
text = "La inyectas: duele, quema, la piel se pone roja y te crece vello en la lengua. Tu vida se duplica, regeneras solo por existir y te sientes un dios de músculo y rabia. Pero te mueves lento y fallas tiros que acertaría un niño. Cuando aciertas, todo muere. Eres un tanque que no piensa. Mueres como siempre, pero moriste fuerte."
category = 2
unlock_condition = {"type": 1, "target_id": "relic_steroid", "count": 1}
flavor_text = "Equipa Esteroides Anabólicos."