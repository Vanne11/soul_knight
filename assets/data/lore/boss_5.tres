[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "boss_5"
title = "Su Pudorosidad, la Hoja de Parra"
text = "La villana: una hoja de higuera gigante con lentes de leer, collar de perlas y opinión sobre todo. Tapó estatuas, cuadros, gente y, al final, el mundo. No odia a nadie: cree que todo está mejor tapado, calladito y en gris. Lanza píxeles de censura. Su drama secreto: nadie la invitó nunca a mirar. Sin nada que tapar, es solo una hoja."
category = 3
unlock_condition = {"type": 9, "target_id": "SU PUDOROSIDAD, LA HOJA DE PARRA"}
flavor_text = "Derrota a la Hoja de Parra."
