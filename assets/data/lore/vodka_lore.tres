[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "vodka_lore"
title = "Vodka: Agua que Miente"
text = "Incolora, inodora, traicionera. +25 intoxicación, -15% precisión, +20% daño. «Es agua», dice el ruso. «Es mentira», dice tu hígado. No sientes nada hasta el calor de después: en el estómago, en la garganta, en tus decisiones. El vodka no tiene sabor, tiene consecuencias. Te vuelve demasiado honesto y te ríes de tus chistes. Nadie más se ríe."
category = 2
unlock_condition = {"type": 4, "target_id": "vodka", "count": 10}
flavor_text = "Bebe 10 vodkas."