[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "boss_alt_1"
title = "La Afeitadora Eléctrica"
text = "Nació para dejar cada cara lisa en tres pasadas y se tomó el trabajo muy en serio. Patrulla la Selva Púbica con cabezal oscilante, cable al enchufe y cero tolerancia a lo que crece. Dato: afeitarse no hace que el vello crezca más grueso, oscuro ni rápido. Es ilusión óptica: la punta recién cortada es roma y se nota más. El folículo ni se entera."
category = 3
unlock_condition = {"type": 9, "target_id": "LA AFEITADORA ELÉCTRICA"}
flavor_text = "Derrota a la Afeitadora Eléctrica."
