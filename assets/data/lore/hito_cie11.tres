[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "hito_cie11"
title = "CIE-11 (2019-2022)"
text = "La OMS aprobó la CIE-11 en mayo de 2019 y entró en vigor el 1 de enero de 2022. La «incongruencia de género» salió del capítulo de trastornos mentales y pasó al de condiciones de salud sexual, porque ser trans no es una enfermedad mental y clasificarlo así genera estigma. Se mantuvo un código para que haya acceso a atención de salud."
category = 7
unlock_condition = {"target_id": "reino_orgullo_entrada", "type": 10}
flavor_text = "Dejó de ser un trastorno; la atención médica se quedó."
