[resource]
script = ExtResource("1")
id = "ene_ego"
title = "Ego Inflado"
text = "Un globo con corbata que se agranda hablando de tamaño: cuanto más se infla, más pega y más lento va. Cada golpe tuyo es la verdad, y la verdad lo desinfla. Dato: en erección, el promedio ronda los 13 cm (meta-análisis de 2015) y muchos creen que es más por culpa del porno. El tamaño importa menos que la conversación."
category = 3
unlock_condition = {"type": 0, "target_id": "Ego Inflado", "count": 6}
flavor_text = "Vence a 6 Egos Inflados (a base de verdades)."
