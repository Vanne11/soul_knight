[gd_resource type="Resource" script_class="LoreEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "puerta_hormonal"
title = "La Puerta Hormonal"
text = "Las salas de jefe de Penelandia, Vulvania y el Perineo tienen Puerta Hormonal. Te huele, arruga la nariz y solo abre si llevas la hormona del reino (las dos, en el Perineo). Sale al limpiar una sala o se compra, a precio de oro. Si es la contraria, trae alergia. A puñetazos no abre: hasta las puertas tienen su límite de vergüenza ajena."
category = 5
unlock_condition = {"type": 10, "target_id": "hormone_door"}
flavor_text = "Cruza una Puerta Hormonal sin la hormona."
