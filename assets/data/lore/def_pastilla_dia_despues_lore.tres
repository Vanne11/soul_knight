[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "def_pastilla_dia_despues_lore"
title = "De Emergencia"
text = "«Es de emergencia, no un método.» Dato: la anticoncepción de emergencia (la «pastilla del día después») se toma lo antes posible tras una relación sin protección o con falla del método: cuanto antes, mejor. No sirve como método habitual, no protege de las ITS y no es abortiva: no interrumpe un embarazo ya en curso."
category = 2
unlock_condition = {"type": 4, "target_id": "def_pastilla_dia_despues", "count": 1}
flavor_text = "Usa una pastilla del día después."
