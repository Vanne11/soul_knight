[ext_resource type="Script" path="res://src/core/lore_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ene_todos"
title = "Todos-lo-Hacen"
text = "Simpático, insistente y siempre con un amigo más en camino: «¡todos lo hacen!». Rompe a quien lleva la corona y el resto se desvanece. Dato: aquí también se pregunta; nada se hace «porque sí» ni «porque todo el mundo lo hace»: sin presión, un sí que se puede retirar. No es obligatorio ni una prueba de nada: se puede hacer, probar o dejarlo; las dos opciones son normales."
category = 3
unlock_condition = {"type": 0, "target_id": "Todos-lo-Hacen", "count": 5}
flavor_text = "Mata 5 todos-lo-hacen."
